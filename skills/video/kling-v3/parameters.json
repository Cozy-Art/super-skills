  "common_mistakes": {
    "generic_motion": {
      "problem": "Uses vague words like 'moves', 'goes', 'walks'",
      "solution": "Use specific motion verbs with descriptors"
    },
    "keyword_spam": {
      "problem": "Image-style prompting with comma-separated terms",
      "solution": "Write structured sentences following 5-layer template"
    },
    "stacked_actions": {
      "problem": "Listing everything in compressed paragraph",
      "solution": "Break into sequential steps with temporal markers"
    },
    "too_many_elements": {
      "problem": ">7 distinct visuals causes failures",
      "solution": "Combine items into categories, focus on 5-7 max"
    },
    "vague_spatial": {
      "problem": "Unclear positioning leads to physics errors",
      "solution": "Explicit spatial language: 'hand gripping', 'making contact with'"
    }
  },
  
