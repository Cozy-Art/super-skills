  "multi_shot_storyboard": {
    "availability": "Kling 3.0 Omni",
    "max_cuts": 6,
    "features": [
      "Automatic camera angle adjustment",
      "Scene coverage understanding",
      "Style continuity across shots"
    ],
    "syntax": {
      "format": "**Shot N (Xs):** [Camera] [Description] @Character: \"[dialogue]\"",
      "example": "**Shot 1 (6s):** Wide shot. Detective enters office. @Detective: \"Someone's been here.\""
    }
  },
  
  "dialogue_attribution": {
    "syntax": "@Character name says, \"dialogue\"",
    "purpose": "Ensures correct lip-sync assignment",
    "examples": [
      "@Detective murmurs, \"This must be it.\"",
      "@Woman responds calmly: \"I know what you're thinking.\""
    ],
    "best_practices": [
      "Always attribute dialogue to specific character",
      "Specify tone/emotion with verb",
      "Keep dialogue natural and concise"
    ]
  },
  
  "temporal_markers": {
    "purpose": "Structure sequential actions within shots",
    "keywords": ["First", "Then", "Next", "Finally", "After", "While"],
    "example": "First, she slows her pace, then looks back briefly, finally continues walking forward."
