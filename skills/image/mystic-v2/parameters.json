  "numeric_parameters": {
    "creative_detailing": {
      "range": "0-100",
      "default": 33,
      "description": "Higher = more detail per pixel but more HDR/artificial",
      "warnings": "Very high values cause artifacts like misplaced eyes",
      "recommendations": {
        "photorealism": "33-50",
        "fantasy_illustration": "40-60",
        "minimalist": "20-40"
      }
    },
    "adherence": {
      "range": "0-100",
      "default": 50,
      "description": "Prompt adherence vs style transfer balance",
      "high_values": "More faithful to prompt, less style transfer",
      "low_values": "More creative, closer to style reference",
      "use_case": "Adjust when using style references"
    },
    "hdr": {
      "range": "0-100",
      "default": 50,
      "description": "Detail level vs natural look balance",
      "high_values": "More detailed but more 'AI look'",
      "low_values": "More natural/artistic but may increase artifacts",
      "recommendation": "Balance with creative_detailing"
    },
    "structure_strength": {
      "range": "0-100",
      "default": 50,
      "description": "How closely to maintain structure of reference image",
      "use_case": "Image-to-image generation"
    },
    "styling_styles_strength": {
      "range": "0-100",
      "default": 100,
      "description": "LoRA style intensity",
      "compatibility": "Only with realism model"
    },
    "styling_characters_strength": {
      "range": "0-100",
      "default": 100,
      "description": "LoRA character intensity",
      "compatibility": "Only with realism model",
      "recommended": 80
    },
    "styling_colors_weight": {
      "range": "0-1",
      "default": 0.5,
      "description": "Color palette influence"
    }
  },
  
  "boolean_parameters": {
    "fixed_generation": {
      "default": false,
      "description": "When enabled, identical settings produce identical images",
      "use_case": "Essential for iterative fine-tuning"
    },
    "filter_nsfw": {
      "default": true,
      "description": "NSFW content filtering",
      "note": "Always on for standard API usage, cannot be disabled without special authorization"
    }
  },
  
  "official_best_practices": {
    "do": [
      "Use concise, direct prompts",
      "Omit contradictory terms",
      "Use negative prompts for intricate details",
      "Fix faces/hands with Retouch or Upscale tools",
      "Include camera specs for photorealism (Canon EOS R5, ARRI Alexa LF)",
      "Use Character reference strength around 80%"
    ],
    "dont": [
      "Don't use lengthy descriptions",
      "Don't specify styles in prompts (use UI selector)",
      "Don't specify pixels, sizes, or quality in text",
      "Don't mention final usage (e.g., 'for website header')",
      "Don't use Prompt Enhancer when prompt is already detailed",
      "Don't use words ending in '-tly' unless necessary",
      "Don't use the word 'background' (causes blurriness)"
    ]
  },
  
