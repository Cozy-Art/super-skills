  "common_issues": {
    "face_hand_distortion": {
      "problem": "Anatomical errors in faces and hands",
      "solution": "Use Retouch or Upscale tools, not re-prompting",
      "expectation": "May need multiple regenerations"
    },
    "lora_compatibility": {
      "problem": "LoRAs silently disabled when switching variants",
      "solution": "Only use realism model for Custom Characters/Styles",
      "affected_variants": ["flexible", "fluid", "zen", "super_real", "editorial_portraits"]
    },
    "background_blurriness": {
      "problem": "Using word 'background' causes blur",
      "solution": "Avoid the word, describe environment differently"
    },
    "fluid_overmoderation": {
      "problem": "Words like 'war' flagged due to Google Imagen 3 backend",
      "solution": "Use alternative phrasing or switch to different variant"
    }
  },
  
