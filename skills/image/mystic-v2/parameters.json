  "prompt_limits": {
    "official_recommendation": "~500 characters should be sufficient",
    "ui_maximum": "~1400 characters reported by community",
    "api_range": "Simple ('a cat') to detailed multi-sentence descriptions",
    "editorial_portraits_recommendation": "Longest and most explanatory prompts possible",
    "best_practice": "Concise and direct, avoid lengthy descriptions"
  },
  
  "special_syntax": {
    "character_references": {
      "basic": "@character_name",
      "with_strength": "@character_name::strength",
      "example": "@john::200",
      "note": "Higher numbers = stronger character presence",
      "recommended_strength": 80,
      "compatibility": "Only works with realism model (LoRA-compatible)"
    },
    "permutation_prompts": {
      "syntax": "option1|option2|option3",
      "example": "a black cat|a red cat|a yellow cat",
      "description": "Generates multiple variants in one request"
    },
    "ai_prompt_enhancement": {
      "toggle": "AI prompt toggle in UI",
      "function": "Auto-expands short prompts",
      "example_input": "A dog",
      "example_output": "A black German Shepherd standing alert on a rocky hilltop with a panoramic view of a valley during sunset",
      "when_to_avoid": "When prompt is already detailed"
    }
