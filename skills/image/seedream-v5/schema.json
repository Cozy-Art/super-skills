{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Seedream Prompt Output Schema",
  "description": "Validation schema for prompt generation output targeting Seedream 5.0 Lite and Seedream 4.5. Supports both plain text and JSON structured prompt modes.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/plain_text_output" },
    { "$ref": "#/definitions/json_structured_output" }
  ],
  
  "definitions": {
    
    "plain_text_output": {
      "type": "object",
      "description": "Output format for plain text prompts (single-subject or creatively open scenes)",
      "required": ["prompt", "variant", "image_size", "prompt_mode"],
      "properties": {
        "prompt_mode": {
          "type": "string",
          "const": "plain_text",
          "description": "Indicates this is a plain text prompt"
        },
        "prompt": {
          "type": "string",
          "minLength": 10,
          "description": "Natural language prompt following Subject > Setting > Style > Lighting > Technical formula. 30-200 words recommended."
        },
        "variant": {
          "type": "string",
          "enum": ["seedream-v5-lite", "seedream-v4.5"],
          "description": "Target model variant"
        },
        "image_size": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "square",
                "square_hd",
                "portrait_4_3",
                "portrait_16_9",
                "landscape_4_3",
                "landscape_16_9",
                "auto_2K",
                "auto_3K"
              ]
            },
            {
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1440,
                  "maximum": 4096
                },
                "height": {
                  "type": "integer",
                  "minimum": 1440,
                  "maximum": 4096
                }
              }
            }
          ],
          "description": "Output dimensions. Preset string or custom {width, height}."
        },
        "num_images": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of separate generations"
        },
        "max_images": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Images per generation. >1 enables multi-image with consistency."
        },
        "seed": {
          "type": ["integer", "null"],
          "description": "Seed for reproducibility. Null for random."
        },
        "negative_prompt": {
          "type": ["string", "null"],
          "description": "Elements to exclude. ONLY used with seedream-v4.5 variant. Must be null for seedream-v5-lite."
        },
        "guidance_scale": {
          "type": ["number", "null"],
          "minimum": 1.0,
          "maximum": 12.0,
          "description": "Prompt adherence strength. ONLY used with seedream-v4.5 (default 7.0) or BytePlus API for v5 (default 5.5). Null for fal.ai/Replicate v5."
        },
        "num_inference_steps": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100,
          "default": 30,
          "description": "Generation quality steps. ONLY used with seedream-v4.5. Null for v5."
        },
        "scheduler": {
          "type": ["string", "null"],
          "enum": ["DPM++ 2M Karras", "Euler A", null],
          "description": "Diffusion sampling method. ONLY used with seedream-v4.5. Null for v5."
        },
        "reference_images": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["url", "purpose"],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "URL or base64 of reference image"
              },
              "purpose": {
                "type": "string",
                "enum": ["character_reference", "style_reference", "product_reference", "edit_source", "example_before", "example_after", "edit_target", "sketch_source"],
                "description": "How this reference image is used"
              }
            }
          },
          "maxItems": 10,
          "description": "Reference images for editing, style transfer, or character consistency"
        },
        "edit_strength": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Edit intensity for image editing mode. ONLY used with seedream-v4.5. Lower = closer to original."
        },
        "directors_notes": {
          "type": "string",
          "description": "Human-readable explanation of prompt decisions for director review"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "variant": { "const": "seedream-v5-lite" } }
          },
          "then": {
            "properties": {
              "negative_prompt": { "type": "null" },
              "num_inference_steps": { "type": "null" },
              "scheduler": { "type": "null" },
              "edit_strength": { "type": "null" }
            }
          }
        }
      ]
    },

    "json_structured_output": {
      "type": "object",
      "description": "Output format for JSON structured prompts (multi-subject, precise placement, HEX color control). ONLY available with seedream-v5-lite.",
      "required": ["prompt_mode", "structured_prompt", "variant", "image_size"],
      "properties": {
        "prompt_mode": {
          "type": "string",
          "const": "json_structured",
          "description": "Indicates this is a JSON structured prompt"
        },
        "structured_prompt": {
          "$ref": "#/definitions/structured_prompt_object"
        },
        "variant": {
          "type": "string",
          "const": "seedream-v5-lite",
          "description": "JSON structured prompts are ONLY supported by seedream-v5-lite"
        },
        "image_size": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "square",
                "square_hd",
                "portrait_4_3",
                "portrait_16_9",
                "landscape_4_3",
                "landscape_16_9",
                "auto_2K",
                "auto_3K"
              ]
            },
            {
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 1440, "maximum": 4096 },
                "height": { "type": "integer", "minimum": 1440, "maximum": 4096 }
              }
            }
          ]
        },
        "num_images": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "max_images": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "seed": {
          "type": ["integer", "null"]
        },
        "reference_images": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["url", "purpose"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "purpose": {
                "type": "string",
                "enum": ["character_reference", "style_reference", "product_reference", "edit_source", "example_before", "example_after", "edit_target", "sketch_source"]
              }
            }
          },
          "maxItems": 10
        },
        "directors_notes": {
          "type": "string",
          "description": "Human-readable explanation of prompt decisions"
        }
      }
    },

    "structured_prompt_object": {
      "type": "object",
      "description": "The JSON object sent to Seedream 5.0 Lite as a structured prompt",
      "required": ["scene", "subjects"],
      "properties": {
        "scene": {
          "type": "string",
          "description": "Overall scene description and context"
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/subject_object"
          },
          "description": "Array of subjects with descriptions, positions, and optional colors"
        },
        "style": {
          "type": "string",
          "description": "Photography or art style reference"
        },
        "lighting": {
          "type": "string",
          "description": "Light direction, quality, color temperature"
        },
        "camera": {
          "type": "object",
          "properties": {
            "angle": {
              "type": "string",
              "description": "Camera angle (e.g., 'directly overhead', 'eye level', 'low angle')"
            },
            "lens": {
              "type": "string",
              "description": "Focal length, aperture, and optional camera body (e.g., '85mm f/1.4', '35mm wide, f/5.6')"
            }
          }
        }
      }
    },

    "subject_object": {
      "type": "object",
      "required": ["description", "position"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 5,
          "description": "Detailed natural language description of the subject. Use double quotation marks for any text that should render literally."
        },
        "position": {
          "type": "string",
          "description": "Spatial placement within the frame",
          "examples": [
            "upper left",
            "upper center",
            "upper right",
            "center left",
            "center",
            "center right",
            "lower left",
            "lower center",
            "lower right",
            "foreground",
            "midground",
            "background",
            "left third",
            "right third",
            "lower right third",
            "full frame background"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Optional HEX color code for this subject element (e.g., '#FF006E'). Use for brand-accurate color control."
        }
      }
    }
  }
}
