# robots.txt — AI crawler policy
# Pick ONE posture below and delete the other two. Then set your own paths.
#
# The distinction that matters: RETRIEVAL bots produce citations in AI answers.
# TRAINING bots feed model weights. They are separate decisions, and most
# people have never made the second one deliberately.
#
# Reminder: if this site sits behind Cloudflare, AWS WAF, or Vercel Firewall,
# that layer answers before this file is ever read. Check it too.

# ---------------------------------------------------------------------------
# POSTURE A — OPEN. Maximum reach; you want to be in the weights and the answers.
# ---------------------------------------------------------------------------
# User-agent: GPTBot
# User-agent: ClaudeBot
# User-agent: CCBot
# User-agent: Google-Extended
# User-agent: Applebot-Extended
# User-agent: OAI-SearchBot
# User-agent: Claude-SearchBot
# User-agent: PerplexityBot
# Allow: /

# ---------------------------------------------------------------------------
# POSTURE B — CITED, NOT TRAINED.  <-- most common choice
# ---------------------------------------------------------------------------
User-agent: OAI-SearchBot
User-agent: Claude-SearchBot
User-agent: PerplexityBot
Allow: /

User-agent: GPTBot
Disallow: /

User-agent: ClaudeBot
Disallow: /

User-agent: CCBot
Disallow: /

User-agent: Google-Extended
Disallow: /

User-agent: Applebot-Extended
Disallow: /

User-agent: Bytespider
Disallow: /

# ---------------------------------------------------------------------------
# POSTURE C — CLOSED. Blocks AI entirely; accepts disappearing from AI answers.
# ---------------------------------------------------------------------------
# User-agent: GPTBot
# User-agent: OAI-SearchBot
# User-agent: ClaudeBot
# User-agent: Claude-SearchBot
# User-agent: PerplexityBot
# User-agent: CCBot
# User-agent: Google-Extended
# User-agent: Applebot-Extended
# User-agent: Bytespider
# User-agent: Meta-ExternalAgent
# User-agent: Amazonbot
# Disallow: /

# ---------------------------------------------------------------------------
# Everyone else, including classic search. Keep this group last.
# ---------------------------------------------------------------------------
User-agent: *
Allow: /
Disallow: /api/
Disallow: /admin/
Disallow: /*?utm_

# Optional: AIPREF Content-Usage. Expresses "you may fetch, but don't train" —
# something robots.txt alone cannot say. Still an IETF draft; voluntary
# compliance; harmless to include.
# Content-Usage: train-ai=n
# Content-Usage: /docs/ train-ai=y

# Optional: Anthropic's bots honor Crawl-delay. Throttle instead of blocking.
# Crawl-delay: 1

